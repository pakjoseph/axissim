  "hypotheses": [
    {
      "hypothesis_id": "H1",
      "statement": "For at least one fixed base case and sensitivity point, RVV and matrix report different serialized read-plus-write service cycles because their logical payload or batch counts differ."
    },
    {
      "hypothesis_id": "H2",
      "statement": "Moving from P4 to P8 reduces the same mapping's compute-only cycles and serialized total cycles for at least one fixed shape and sensitivity setting."
    },
    {
      "hypothesis_id": "H3",
      "statement": "At fixed shape, capacity, setup, and mapping, higher declared bandwidth never increases read service, write service, or total serialized cycles; at least one service result decreases strictly."
    },
    {
      "hypothesis_id": "H4",
      "statement": "At fixed shape, capacity, bandwidth, and mapping, increasing setup from zero to one cycle per batch never decreases total cycles, and increases totals wherever returned A/B/C batch counts are nonzero."
    },
    {
      "hypothesis_id": "H5",
      "statement": "At least one selected case has a strict compute-cycle winner that is not the strict serialized-total winner."
    }
  ],
